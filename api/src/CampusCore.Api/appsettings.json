{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "REPLACE_VIA_ENVIRONMENT_VARIABLE_OR_DEVELOPMENT_CONFIG"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_IN_PRODUCTION_ENVIRONMENT_VARIABLES",
