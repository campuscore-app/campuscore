# Copy this file to .env in the same folder as docker-compose.yml and fill
# in real values before running `docker compose up`. Never commit the
# real .env file — it holds your database password and JWT signing key.

# --- Database ---
POSTGRES_DB=campuscore
POSTGRES_USER=campuscore
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- API ---
# Must be a long, random string in production — anyone who has it can forge
# valid login tokens. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_at_least_32_characters

# The URL the browser will load the frontend from — the API only accepts
# cross-origin requests from this origin (see Cors:AllowedOrigins).
WEB_ORIGIN=http://localhost:5173

# The URL the browser will use to reach the API. Baked into the frontend
# build, so if you change this after first `docker compose up`, rebuild the
# web image (`docker compose build web`) for it to take effect.
API_ORIGIN=http://localhost:5073
